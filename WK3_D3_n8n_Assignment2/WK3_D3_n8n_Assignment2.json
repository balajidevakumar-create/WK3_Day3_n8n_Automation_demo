    {
      "parameters": {
        "jsCode": "const output = [];\n\nfor (const item of $input.all()) {\n  let data = item.json;\n\n  try {\n    // If AI output is inside a string, parse it\n    if (typeof data === 'string') {\n      data = JSON.parse(data);\n    }\n\n    // Handle common AI output fields\n    if (typeof data.output === 'string') {\n      data = JSON.parse(data.output);\n    }\n\n    if (typeof data.text === 'string') {\n      data = JSON.parse(data.text);\n    }\n\n    // Clean the record\n    const cleaned = {\n      Student_ID: String(data.Student_ID ?? '').trim(),\n      Name: String(data.Name ?? '').trim(),\n      Email: String(data.Email ?? '').trim().toLowerCase(),\n      Phone: String(data.Phone ?? '').trim(),\n      Course: String(data.Course ?? '').trim(),\n      Fee_Paid: Boolean(data.Fee_Paid),\n      City: String(data.City ?? '').trim(),\n      Enrolled_Date: String(data.Enrolled_Date ?? '').trim(),\n    };\n\n    // Email validation\n    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n    const emailValid = emailRegex.test(cleaned.Email);\n\n    // Phone validation\n    const phoneDigits = cleaned.Phone.replace(/\\D/g, '');\n    const phoneValid = /^[0-9]{10}$/.test(phoneDigits);\n\n    // Date validation\n    const dateValid = /^\\d{4}-\\d{2}-\\d{2}$/.test(cleaned.Enrolled_Date);\n\n    // Add validation status\n    cleaned.Email = emailValid ? cleaned.Email : '';\n    cleaned.Phone = phoneValid ? phoneDigits : '';\n\n    cleaned.Email_Valid = emailValid;\n    cleaned.Phone_Valid = phoneValid;\n    cleaned.Date_Valid = dateValid;\n\n    output.push({\n      json: cleaned\n    });\n\n  } catch (error) {\n    // Keep bad records instead of stopping the entire workflow\n    output.push({\n      json: {\n        ...data,\n        Parse_Error: true,\n        Error_Message: error.message\n      }\n    });\n  }\n}\n\nreturn output;"
      },
